---
const shades = [
  { vlt: 50, label: 'Light' },
  { vlt: 35, label: 'Standard' },
  { vlt: 25, label: 'Dark' },
  { vlt: 15, label: 'Very dark' },
  { vlt: 5, label: 'Limo' },
];
---

<div data-tint>
  <div class="relative aspect-video overflow-hidden rounded-xl border border-navy/10 bg-navy">
    <img
      src="/images/hero-car.webp"
      alt="Vehicle tint preview — replace with a clean side profile with clear glass"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black transition-opacity duration-150" data-tint-overlay style="opacity: 0.8"></div>
    <div class="absolute bottom-3 left-3 rounded bg-navy/85 px-3 py-1 text-sm font-bold text-cream" data-tint-readout>20% VLT</div>
  </div>

  <div class="mt-4">
    <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-navy/60" for="tint-slider">
      Drag to preview darkness
    </label>
    <input id="tint-slider" type="range" min="5" max="50" value="20" step="1" data-tint-slider class="w-full accent-[#e6863a]" />
    <div class="mt-2 flex flex-wrap gap-2">
      {shades.map((s) => (
        <button type="button" data-vlt={s.vlt} class="rounded-full border border-navy/15 px-3 py-1 text-xs font-semibold text-navy/70 transition hover:border-accent hover:text-accent">
          {s.vlt}% · {s.label}
        </button>
      ))}
    </div>
  </div>
  <p class="mt-3 text-xs text-navy/50">
    Preview only — actual darkness varies by film and glass. Final shade is set within your state's legal limits at install.
  </p>
</div>

<script>
  for (const el of document.querySelectorAll('[data-tint]')) {
    const slider = el.querySelector<HTMLInputElement>('[data-tint-slider]')!;
    const overlay = el.querySelector<HTMLElement>('[data-tint-overlay]')!;
    const readout = el.querySelector<HTMLElement>('[data-tint-readout]')!;

    const set = (vlt: number) => {
      overlay.style.opacity = String((100 - vlt) / 100);
      readout.textContent = `${vlt}% VLT`;
    };

    slider.addEventListener('input', () => set(Number(slider.value)));
    for (const b of el.querySelectorAll<HTMLButtonElement>('[data-vlt]')) {
      b.addEventListener('click', () => {
        slider.value = b.dataset.vlt!;
        set(Number(b.dataset.vlt));
      });
    }
    set(Number(slider.value));
  }
</script>
