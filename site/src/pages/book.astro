---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingWizard from "../components/BookingWizard.astro";
---

<BaseLayout
  title="Book Now — On-Wheels Detailing"
  description="Book your mobile or in-shop detail, window tinting, or undercoating with On-Wheels Detailing."
>
  <section class="bg-navy py-20 text-center">
    <div class="container-x">
      <h1 class="text-cream text-5xl font-bold md:text-6xl">Book Now</h1>
      <p class="text-cream/75 mx-auto mt-4 max-w-xl">
        Tell us where you are and what you need — we'll take it from there.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="mx-auto max-w-2xl">
      <BookingWizard />
      <p class="text-navy/60 mt-6 text-center text-sm">
        Prefer to talk? Call or text
        <a
          href="tel:+15868730656"
          class="text-accent font-semibold hover:underline">(586) 873-0656</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>
