---
import BaseLayout from "../layouts/BaseLayout.astro";
import Placeholder from "../components/Placeholder.astro";
import BeforeAfter from "../components/BeforeAfter.astro";

const services = [
  {
    name: "Detailing",
    href: "/services#detailing",
    desc: "Interior refresh, steam & hot-water extraction, full cleans.",
    price: "From $150",
  },
  {
    name: "Paint & Ceramic",
    href: "/services#paint-ceramic",
    desc: "Correction, polishing, and CarPro CQuartz 3.0 ceramic coatings.",
    price: "From $200",
  },
  {
    name: "Window Tinting",
    href: "/tinting",
    desc: "GEOShield films, ceramic, nano-ceramic & carbon. See your shade.",
    price: "By film",
  },
  {
    name: "Undercoating",
    href: "/undercoating",
    desc: "Fluid Film & Woolwax rust protection for Michigan winters.",
    price: "$175–$300",
  },
];

const stats = [
  { value: "5★", label: "Google rated" },
  { value: "50+", label: "Vehicles detailed" },
  { value: "2025", label: "Founded by TaSain" },
  { value: "MI + TX", label: "Two-state service" },
];

const brands = [
  "CarPro",
  "Koch Chemie",
  "P&S",
  "Oberk",
  "GEOShield",
  "Fluid Film",
  "3D",
  "Meguiar's",
];

const googleRating = {
  score: "5.0",
  count: null, // fill in the real Google review count when known
};

const reviews = [
  {
    quote:
      "SAMPLE REVIEW: replace with a real Google review naming the service and town.",
    name: "Customer Name",
    town: "City, MI",
  },
  {
    quote:
      "SAMPLE REVIEW: replace with a real Google review naming the service and town.",
    name: "Customer Name",
    town: "City, MI",
  },
  {
    quote:
      "SAMPLE REVIEW: replace with a real Google review naming the service and town.",
    name: "Customer Name",
    town: "City, MI",
  },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "AutoDetailing",
  name: "On-Wheels Detailing",
  url: "https://www.onwheelsdetailing.com",
  telephone: "+15868730656",
  email: "tasain@onwheelsdetailing.com",
  priceRange: "$150-$2000",
  founder: { "@type": "Person", name: "TaSain" },
  areaServed: [
    "Port Huron",
    "St. Clair",
    "Marysville",
    "New Haven",
    "Algonac",
    "Yale",
    "Lexington",
    "Richmond",
    "Mt. Clemens",
    "St. Clair Shores",
    "Houston",
  ],
};
---

<BaseLayout
  title="On-Wheels Detailing | Mobile & In-Shop Auto Detailing | Michigan & Texas"
  description="Premium mobile and in-shop auto detailing, ceramic coating, window tinting, and undercoating. Founded by TaSain, serving Port Huron, St. Clair & Macomb County and Houston."
>
  <!-- HERO -->
  <section class="bg-navy relative overflow-hidden">
    <img
      src="/images/hero-car.webp"
      alt="Recently detailed vehicle with mirror finish"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      width="1600"
      height="900"
    />
    <div
      class="from-navy/90 via-navy/40 absolute inset-0 bg-gradient-to-r to-transparent"
    >
    </div>
    <div class="container-x relative py-28 md:py-40">
      <p
        class="font-display text-gold text-sm font-semibold tracking-[0.25em] uppercase"
      >
        Built by TaSain · Est. 2025
      </p>
      <h1 class="text-cream mt-4 max-w-3xl text-5xl font-bold md:text-7xl">
        Detailing <span class="text-accent">reimagined.</span>
      </h1>
      <p class="text-cream/85 mt-5 max-w-xl text-lg">
        Showroom finish. Mobile convenience. One detailer who treats your car
        like his own.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/book"
          class="bg-accent hover:bg-gold hover:text-navy rounded-full px-7 py-3.5 font-semibold text-white shadow-lg transition"
        >
          Book Now
        </a>
        <a
          href="/gallery"
          class="border-cream/40 text-cream hover:bg-cream hover:text-navy rounded-full border px-7 py-3.5 font-semibold transition"
        >
          See Our Work
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="border-navy/10 bg-sand border-b">
    <div class="container-x grid grid-cols-2 gap-6 py-8 md:grid-cols-4">
      {
        stats.map((s) => (
          <div class="text-center">
            <p class="font-display text-navy text-3xl font-bold">{s.value}</p>
            <p class="text-navy/60 mt-1 text-xs tracking-wide uppercase">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- OWNER INTRO -->
  <section class="container-x grid items-center gap-10 py-20 md:grid-cols-2">
    <div>
      <p
        class="font-display text-accent text-sm font-semibold tracking-[0.2em] uppercase"
      >
        Meet your detailer
      </p>
      <h2 class="text-navy mt-3 text-4xl font-bold md:text-5xl">
        Not a crew. <span class="text-accent">A craftsman.</span>
      </h2>
      <p class="text-navy/75 mt-5">
        On-Wheels Detailing started in 2025 with one buffer and one promise:
        treat every car like it's my own. Today that's grown into mobile
        detailing across Port Huron, St. Clair & Macomb County, two garage
        locations, an undercoating bay, and window tinting, all still built on
        the same hands-on standard.
      </p>
      <ul class="text-navy/80 mt-6 space-y-2">
        <li>• Certified, pro-grade products, no parts-store shortcuts</li>
        <li>• Real before/after results, not stock photos</li>
        <li>• A personal guarantee: if it's not right, I'll make it right</li>
      </ul>
      <a
        href="/about"
        class="bg-navy text-cream hover:bg-slate mt-7 inline-block rounded-full px-6 py-3 font-semibold transition"
      >
        Read the full story
      </a>
    </div>
    <Placeholder
      label="Owner portrait, TaSain at work"
      note="Upload: images/owner-ta-sain.webp · 1200×900"
      class="aspect-[4/3]"
    />
  </section>

  <!-- SERVICES -->
  <section class="bg-sand py-20">
    <div class="container-x">
      <div class="text-center">
        <h2 class="text-navy text-4xl font-bold md:text-5xl">What we do</h2>
        <p class="text-navy/70 mx-auto mt-3 max-w-xl">
          Four ways to protect and transform your vehicle, all under one roof.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s) => (
            <a
              href={s.href}
              class="group border-navy/10 bg-cream rounded-xl border p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
            >
              <p class="font-display text-accent text-xs font-semibold tracking-wide uppercase">
                {s.price}
              </p>
              <h3 class="text-navy group-hover:text-accent mt-2 text-2xl font-bold">
                {s.name}
              </h3>
              <p class="text-navy/70 mt-2 text-sm">{s.desc}</p>
              <span class="text-accent mt-4 inline-block text-sm font-semibold">
                Learn more →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  <section class="container-x py-20">
    <div class="text-center">
      <h2 class="text-navy text-4xl font-bold md:text-5xl">
        The proof is in the paint
      </h2>
      <p class="text-navy/70 mx-auto mt-3 max-w-xl">
        Interactive before/after slider coming here, drag to see the
        transformation.
      </p>
    </div>
    <div class="mx-auto mt-10 max-w-4xl">
      <BeforeAfter
        before="/images/IMG_2071.webp"
        after="/images/IMG_2288.webp"
        alt="Paint correction demo"
      />
      <p class="text-navy/50 mt-3 text-center text-xs">
        Demo images, replace with a real before/after pair.
      </p>
    </div>
  </section>

  <!-- PRODUCTS WE TRUST -->
  <section class="border-navy/10 bg-sand border-y py-12">
    <div class="container-x">
      <p
        class="font-display text-navy/60 text-center text-sm font-semibold tracking-[0.2em] uppercase"
      >
        Products we trust
      </p>
      <div
        class="mt-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-4"
      >
        {
          brands.map((b) => (
            <span class="font-display text-navy/40 text-2xl font-semibold tracking-wide uppercase">
              {b}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GOOGLE REVIEWS -->
  <section class="container-x py-20">
    <div class="text-center">
      <p
        class="font-display text-accent text-sm font-semibold tracking-[0.2em] uppercase"
      >
        Reputation
      </p>
      <h2 class="text-navy mt-3 text-4xl font-bold md:text-5xl">
        What your neighbors are saying
      </h2>
      <p class="text-navy/70 mx-auto mt-3 max-w-xl">
        Real Google reviews from real details across St. Clair & Macomb County.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <div class="flex flex-col items-center gap-2 text-center">
        <div class="flex items-center gap-2">
          <svg
            viewBox="0 0 48 48"
            class="h-7 w-7"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill="#EA4335"
              d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
            />
            <path
              fill="#4285F4"
              d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
            />
            <path
              fill="#FBBC05"
              d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
            />
            <path
              fill="#34A853"
              d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
            />
          </svg>
          <span class="text-navy/70 text-sm font-semibold">Google Reviews</span>
        </div>
        <div class="flex items-baseline gap-3">
          <span class="font-display text-navy text-5xl font-bold"
            >{googleRating.score}</span
          >
          <span class="text-gold text-2xl" aria-hidden="true">★★★★★</span>
        </div>
        {
          googleRating.count && (
            <p class="text-navy/60 text-sm">
              Based on {googleRating.count} Google reviews
            </p>
          )
        }
        <a
          href="https://g.page/r/CS4aNgHfsCsaEBM"
          target="_blank"
          rel="noopener"
          class="text-navy/60 text-sm hover:underline"
          >Read all reviews on Google →</a
        >
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          reviews.map((r) => (
            <figure class="border-navy/10 bg-cream rounded-xl border p-6 shadow-sm">
              <div class="text-gold" aria-hidden="true">★★★★★</div>
              <blockquote class="text-navy/80 mt-3 text-sm">{r.quote}</blockquote>
              <figcaption class="text-navy mt-4 text-sm font-semibold">
                {r.name}<span class="text-navy/50 font-normal">, {r.town}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="https://g.page/r/CS4aNgHfsCsaEBM/review"
          target="_blank"
          rel="noopener"
          class="bg-navy text-cream hover:bg-slate rounded-full px-6 py-3 font-semibold transition"
          >Leave a review</a
        >
        <a
          href="https://g.page/r/CS4aNgHfsCsaEBM"
          target="_blank"
          rel="noopener"
          class="border-navy/15 text-navy hover:bg-sand rounded-full border px-6 py-3 font-semibold transition"
          >Read all reviews</a
        >
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="bg-navy py-20">
    <div class="container-x text-center">
      <h2 class="text-cream text-4xl font-bold md:text-5xl">
        Ready to book your detail?
      </h2>
      <p class="text-cream/75 mx-auto mt-4 max-w-xl">
        Text or call (586) 873-0656, or book online, serving Port Huron, St.
        Clair & Macomb County and Houston.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/book"
          class="bg-accent hover:bg-gold hover:text-navy rounded-full px-8 py-4 font-semibold text-white shadow-lg transition"
          >Book Now</a
        >
        <a
          href="tel:+15868730656"
          class="border-cream/40 text-cream hover:bg-cream hover:text-navy rounded-full border px-8 py-4 font-semibold transition"
          >Call (586) 873-0656</a
        >
      </div>
    </div>
  </section>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(ldJson)}
  />
</BaseLayout>
