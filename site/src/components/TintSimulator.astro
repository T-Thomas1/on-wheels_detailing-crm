---
const shades = [
  { vlt: 50, label: "Light" },
  { vlt: 35, label: "Standard" },
  { vlt: 25, label: "Dark" },
  { vlt: 15, label: "Very dark" },
  { vlt: 5, label: "Limo" },
];
---

<div data-tint>
  <div
    class="border-navy/10 relative overflow-hidden rounded-xl border bg-gradient-to-b from-slate-100 to-slate-200"
  >
    <svg
      viewBox="0 0 800 300"
      class="w-full"
      role="img"
      aria-label="Car tint preview"
    >
      <defs>
        <clipPath id="tint-glass">
          <path
            d="M268 176 L295 150 C310 140 330 134 355 132 L445 132 C470 132 490 140 505 150 L535 176 Z"
          ></path>
        </clipPath>
      </defs>

      <!-- ground shadow -->
      <ellipse cx="400" cy="288" rx="330" ry="10" fill="rgba(13,46,72,0.08)"
      ></ellipse>

      <!-- body -->
      <path
        d="M70 235 C70 215 95 205 125 203 L175 196 C205 190 235 182 265 176 L295 150 C310 140 330 134 355 132 L445 132 C470 132 490 140 505 150 L535 176 C565 184 600 190 635 194 L685 200 C720 204 740 216 745 232 L747 252 C747 272 715 280 650 280 L150 280 C95 280 70 265 70 235 Z"
        fill="#cbd5e1"></path>

      <!-- clear glass base -->
      <path
        d="M268 176 L295 150 C310 140 330 134 355 132 L445 132 C470 132 490 140 505 150 L535 176 Z"
        fill="#dbeafe"></path>

      <!-- tint overlay (clipped to glass) -->
      <rect
        x="0"
        y="0"
        width="800"
        height="300"
        fill="#000"
        clip-path="url(#tint-glass)"
        opacity="0.8"
        data-tint-overlay></rect>

      <!-- glass outline -->
      <path
        d="M268 176 L295 150 C310 140 330 134 355 132 L445 132 C470 132 490 140 505 150 L535 176 Z"
        fill="none"
        stroke="#475569"
        stroke-width="3"></path>

      <!-- wheels -->
      <circle cx="185" cy="272" r="42" fill="#0f172a"></circle>
      <circle cx="185" cy="272" r="18" fill="#e2e8f0"></circle>
      <circle cx="615" cy="272" r="42" fill="#0f172a"></circle>
      <circle cx="615" cy="272" r="18" fill="#e2e8f0"></circle>
    </svg>

    <div
      class="bg-navy/85 text-cream absolute bottom-3 left-3 rounded px-3 py-1 text-sm font-bold"
      data-tint-readout
    >
      20% VLT
    </div>
  </div>

  <div class="mt-4">
    <label
      class="text-navy/60 mb-1 block text-xs font-semibold tracking-wide uppercase"
      for="tint-slider"
    >
      Drag to preview darkness
    </label>
    <input
      id="tint-slider"
      type="range"
      min="5"
      max="50"
      value="20"
      step="1"
      data-tint-slider
      class="w-full accent-[#e6863a]"
    />
    <div class="mt-2 flex flex-wrap gap-2">
      {
        shades.map((s) => (
          <button
            type="button"
            data-vlt={s.vlt}
            class="border-navy/15 text-navy/70 hover:border-accent hover:text-accent rounded-full border px-3 py-1 text-xs font-semibold transition"
          >
            {s.vlt}% · {s.label}
          </button>
        ))
      }
    </div>
  </div>
  <p class="text-navy/50 mt-3 text-xs">
    Preview only, actual darkness varies by film and glass. Final shade is set
    within your state's legal limits at install.
  </p>
</div>

<script>
  for (const el of document.querySelectorAll("[data-tint]")) {
    const slider = el.querySelector<HTMLInputElement>("[data-tint-slider]")!;
    const overlay = el.querySelector<SVGElement>("[data-tint-overlay]")!;
    const readout = el.querySelector<HTMLElement>("[data-tint-readout]")!;

    const set = (vlt: number) => {
      overlay.style.opacity = String((100 - vlt) / 100);
      readout.textContent = `${vlt}% VLT`;
    };

    slider.addEventListener("input", () => set(Number(slider.value)));
    for (const b of el.querySelectorAll<HTMLButtonElement>("[data-vlt]")) {
      b.addEventListener("click", () => {
        slider.value = b.dataset.vlt!;
        set(Number(b.dataset.vlt));
      });
    }
    set(Number(slider.value));
  }
</script>
