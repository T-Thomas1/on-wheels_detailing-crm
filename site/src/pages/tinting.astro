---
import BaseLayout from '../layouts/BaseLayout.astro';
import TintSimulator from '../components/TintSimulator.astro';

const films = [
  { name: 'Carbon', desc: 'Great heat rejection, classic smoked look.', tag: 'Value' },
  { name: 'Nano-Ceramic', desc: 'Superior heat rejection, no signal interference.', tag: 'Best value' },
  { name: 'Ceramic', desc: 'Maximum IR/UV rejection, clearest optics, longest life.', tag: 'Premium' },
];
---

<BaseLayout
  title="Window Tinting — GEOShield Films | On-Wheels Detailing"
  description="GEOShield window tinting in Michigan and Texas. Ceramic, nano-ceramic and carbon films — preview your shade with the interactive viewer."
>
  <section class="bg-navy py-20">
    <div class="container-x text-center">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.25em] text-gold">GEOShield</p>
      <h1 class="mt-3 text-5xl font-bold text-cream md:text-6xl">Window Tinting</h1>
      <p class="mx-auto mt-4 max-w-xl text-cream/75">
        Cooler cabin. UV protection. Privacy that turns heads. Choose your film, preview your shade.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-6 md:grid-cols-3">
      {films.map((f) => (
        <div class="rounded-xl border border-navy/10 bg-sand p-6">
          <span class="inline-block rounded-full bg-accent px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">{f.tag}</span>
          <h2 class="mt-3 text-2xl font-bold text-navy">{f.name}</h2>
          <p class="mt-2 text-sm text-navy/70">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sand py-16">
    <div class="container-x">
      <h2 class="text-center text-3xl font-bold text-navy md:text-4xl">Preview your shade</h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-navy/70">
        Interactive tint simulator goes here — drag a slider from 50% down to 5% to see the darkness on a real car.
      </p>
      <div class="mx-auto mt-8 max-w-3xl">
        <TintSimulator />
      </div>
    </div>
  </section>

  <section class="container-x py-16">
    <h2 class="text-2xl font-bold text-navy">Know the legal limits</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      <div class="rounded-xl border border-navy/10 bg-cream p-6">
        <h3 class="font-bold text-navy">Michigan</h3>
        <ul class="mt-2 space-y-1 text-sm text-navy/70">
          <li>Rear side &amp; back windows: any darkness.</li>
          <li>Front side windows: restricted by position — no simple VLT cap; we apply compliant film.</li>
          <li>Windshield: non-reflective strip above the AS-1 line only.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-navy/10 bg-cream p-6">
        <h3 class="font-bold text-navy">Texas</h3>
        <ul class="mt-2 space-y-1 text-sm text-navy/70">
          <li>Front side windows: 25% VLT minimum (must allow &gt;25% light).</li>
          <li>Rear side &amp; back windows: any darkness.</li>
          <li>Windshield: non-reflective strip above the AS-1 line (top 5&quot;).</li>
        </ul>
      </div>
    </div>
    <p class="mt-4 text-sm text-navy/50">Final compliance is confirmed at install based on your state and vehicle.</p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What window tint films does On-Wheels offer?', acceptedAnswer: { '@type': 'Answer', text: 'GEOShield ceramic, nano-ceramic, and carbon films, applied in Michigan and Texas.' } },
      { '@type': 'Question', name: 'What is the legal window tint in Michigan?', acceptedAnswer: { '@type': 'Answer', text: 'Rear and back windows can be any darkness. Front side windows are restricted by position, and the windshield allows only a non-reflective strip above the AS-1 line.' } },
      { '@type': 'Question', name: 'What is the legal window tint in Texas?', acceptedAnswer: { '@type': 'Answer', text: 'Front side windows must allow more than 25% of light. Rear and back windows can be any darkness.' } },
    ],
  })}></script>
</BaseLayout>
