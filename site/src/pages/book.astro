---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Book Now — On-Wheels Detailing"
  description="Book your mobile or in-shop detail, tinting, or undercoating with On-Wheels Detailing."
>
  <section class="bg-navy py-20 text-center">
    <div class="container-x">
      <h1 class="text-5xl font-bold text-cream md:text-6xl">Book Now</h1>
      <p class="mx-auto mt-4 max-w-xl text-cream/75">
        The multi-step booking wizard lands here. For now — call or text to schedule.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="tel:+15868730656" class="rounded-full bg-accent px-8 py-4 font-semibold text-white transition hover:bg-gold hover:text-navy">Call (586) 873-0656</a>
        <a href="mailto:tasain@onwheelsdetailing.com" class="rounded-full border border-cream/40 px-8 py-4 font-semibold text-cream transition hover:bg-cream hover:text-navy">Email</a>
      </div>
    </div>
  </section>
</BaseLayout>
