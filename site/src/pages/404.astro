---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — On-Wheels Detailing" description="This page doesn't exist.">
  <section class="container-x py-32 text-center">
    <h1 class="text-6xl font-bold text-navy">404</h1>
    <p class="mt-4 text-navy/70">That page drove off. Let's get you back on the road.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-accent px-7 py-3 font-semibold text-white">Go home</a>
  </section>
</BaseLayout>
