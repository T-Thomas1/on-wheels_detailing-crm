---
import BaseLayout from "../layouts/BaseLayout.astro";
import TintSimulator from "../components/TintSimulator.astro";

const films = [
  {
    name: "C2 Carbon",
    desc: "GEOShield carbon film. Great heat rejection, classic smoked look.",
    tag: "Value",
  },
  {
    name: "C2 Ceramic",
    desc: "GEOShield ceramic. Strong heat rejection, true black finish.",
    tag: "Best value",
  },
  {
    name: "Pro Nano",
    desc: "GEOShield nano-ceramic. Superior heat rejection, no signal interference.",
    tag: "Premium",
  },
];
---

<BaseLayout
  title="Window Tinting | GEOShield Films | On-Wheels Detailing"
  description="GEOShield window tinting in Michigan and Texas. Ceramic, nano-ceramic and carbon films, preview your shade with the interactive viewer."
>
  <section class="bg-navy py-20">
    <div class="container-x text-center">
      <p
        class="font-display text-gold text-sm font-semibold tracking-[0.25em] uppercase"
      >
        GEOShield
      </p>
      <h1 class="text-cream mt-3 text-5xl font-bold md:text-6xl">
        Window Tinting
      </h1>
      <p class="text-cream/75 mx-auto mt-4 max-w-xl">
        Cooler cabin. UV protection. Privacy that turns heads. Choose your film,
        preview your shade.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-6 md:grid-cols-3">
      {
        films.map((f) => (
          <div class="border-navy/10 bg-sand rounded-xl border p-6">
            <span class="bg-accent inline-block rounded-full px-3 py-1 text-xs font-semibold tracking-wide text-white uppercase">
              {f.tag}
            </span>
            <h2 class="text-navy mt-3 text-2xl font-bold">{f.name}</h2>
            <p class="text-navy/70 mt-2 text-sm">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-sand py-16">
    <div class="container-x">
      <h2 class="text-navy text-center text-3xl font-bold md:text-4xl">
        Preview your shade
      </h2>
      <p class="text-navy/70 mx-auto mt-3 max-w-xl text-center">
        Interactive tint simulator goes here, drag a slider from 50% down to 5%
        to see the darkness on a real car.
      </p>
      <div class="mx-auto mt-8 max-w-3xl">
        <TintSimulator />
      </div>
    </div>
  </section>

  <section class="container-x py-16">
    <h2 class="text-navy text-2xl font-bold">Know the legal limits</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      <div class="border-navy/10 bg-cream rounded-xl border p-6">
        <h3 class="text-navy font-bold">Michigan</h3>
        <ul class="text-navy/70 mt-2 space-y-1 text-sm">
          <li>Rear side &amp; back windows: any darkness.</li>
          <li>
            Front side windows: restricted by position, no simple VLT cap; we
            apply compliant film.
          </li>
          <li>Windshield: non-reflective strip above the AS-1 line only.</li>
        </ul>
      </div>
      <div class="border-navy/10 bg-cream rounded-xl border p-6">
        <h3 class="text-navy font-bold">Texas</h3>
        <ul class="text-navy/70 mt-2 space-y-1 text-sm">
          <li>
            Front side windows: 25% VLT minimum (must allow &gt;25% light).
          </li>
          <li>Rear side &amp; back windows: any darkness.</li>
          <li>
            Windshield: non-reflective strip above the AS-1 line (top 5&quot;).
          </li>
        </ul>
      </div>
    </div>
    <p class="text-navy/50 mt-4 text-sm">
      Final compliance is confirmed at install based on your state and vehicle.
    </p>
  </section>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What window tint films does On-Wheels offer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "GEOShield films: C2 (carbon), C2 Ceramic (ceramic), and Pro Nano (nano-ceramic), applied in Michigan and Texas.",
          },
        },
        {
          "@type": "Question",
          name: "What is the legal window tint in Michigan?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Rear and back windows can be any darkness. Front side windows are restricted by position, and the windshield allows only a non-reflective strip above the AS-1 line.",
          },
        },
        {
          "@type": "Question",
          name: "What is the legal window tint in Texas?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Front side windows must allow more than 25% of light. Rear and back windows can be any darkness.",
          },
        },
      ],
    })}
  />
</BaseLayout>
