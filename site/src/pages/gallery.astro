---
import BaseLayout from "../layouts/BaseLayout.astro";
import Placeholder from "../components/Placeholder.astro";

const shots = [
  { id: "IMG_2071", alt: "Detail job, 2071" },
  { id: "IMG_2288", alt: "Detail job, 2288" },
  { id: "IMG_2577", alt: "Detail job, 2577" },
  { id: "IMG_2700", alt: "Detail job, 2700" },
  { id: "IMG_2967", alt: "Detail job, 2967" },
  { id: "IMG_3123", alt: "Detail job, 3123" },
  { id: "IMG_3131", alt: "Detail job, 3131" },
  { id: "IMG_3170", alt: "Detail job, 3170" },
  { id: "IMG_3954", alt: "Detail job, 3954" },
  { id: "IMG_4386", alt: "Detail job, 4386" },
  { id: "IMG_4396", alt: "Detail job, 4396" },
  { id: "IMG_4649", alt: "Detail job, 4649" },
];
---

<BaseLayout
  title="Recent Work | Gallery | On-Wheels Detailing"
  description="Real detail jobs by On-Wheels Detailing, before and after paint correction, interior restoration, and ceramic coating."
>
  <section class="bg-navy py-20 text-center">
    <div class="container-x">
      <h1 class="text-cream text-5xl font-bold md:text-6xl">Recent Work</h1>
      <p class="text-cream/75 mx-auto mt-4 max-w-xl">
        Real cars, real results. No stock photos.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        shots.map((s) => (
          <figure class="border-navy/10 bg-sand overflow-hidden rounded-xl border">
            <img
              src={`/images/${s.id}-800w.webp`}
              srcset={`/images/${s.id}-400w.webp 400w, /images/${s.id}-800w.webp 800w, /images/${s.id}-1200w.webp 1200w`}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              alt={s.alt}
              loading="lazy"
              decoding="async"
              width="800"
              height="600"
              class="aspect-[4/3] w-full object-cover"
            />
          </figure>
        ))
      }
      <Placeholder
        label="Add Texas job photo"
        note="Upload: images/tx-job-1.webp"
        class="aspect-[4/3]"
      />
    </div>
  </section>
</BaseLayout>
