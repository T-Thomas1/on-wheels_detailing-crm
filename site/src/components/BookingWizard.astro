---
// Booking wizard, multi-step, posts to the existing CRM API.
// Fails open: if the API is unreachable (e.g. local dev), it falls back to a
// bundled service list and a "call to book" confirmation instead of erroring.
const locations = [
  {
    value: "Michigan - Metro Detroit",
    label: "Mobile, Port Huron & St. Clair area",
  },
  { value: "Michigan - St. Clair", label: "Mobile, St. Clair / Port Huron" },
  {
    value: "Michigan - Marysville (Shop)",
    label: "Marysville garage (tinting)",
  },
  {
    value: "Michigan - New Haven (Shop)",
    label: "New Haven garage (tinting + undercoating)",
  },
  { value: "Texas - Harris County", label: "Mobile, Houston, TX" },
];

const timeSlots = [
  "9:00 AM",
  "10:00 AM",
  "11:00 AM",
  "12:00 PM",
  "1:00 PM",
  "2:00 PM",
  "3:00 PM",
  "4:00 PM",
  "5:00 PM",
];

const gmapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
---

<div
  data-wizard
  data-gmaps-key={gmapsKey}
  class="border-navy/10 bg-cream rounded-2xl border p-6 shadow-sm md:p-8"
>
  <!-- Progress -->
  <ol
    class="text-navy/50 mb-6 flex items-center gap-2 text-xs font-semibold tracking-wide uppercase"
    data-progress
  >
    {
      ["Location", "Service", "Vehicle", "Date", "Review"].map((s, i) => (
        <li class="flex items-center gap-2" data-step-indicator={i + 1}>
          <span class="bg-sand text-navy grid h-6 w-6 place-items-center rounded-full">
            {i + 1}
          </span>
          <span class="hidden sm:inline">{s}</span>
          {i < 4 && <span class="text-navy/30">→</span>}
        </li>
      ))
    }
  </ol>

  <p class="text-navy/40 mb-4 text-xs font-medium">* Required</p>

  <!-- Step 1: Location -->
  <div data-step="1">
    <h2 class="font-display text-navy text-2xl font-bold uppercase">
      Where are you?
    </h2>
    <div class="mt-4 grid gap-2 sm:grid-cols-2">
      {
        locations.map((l) => (
          <label class="border-navy/15 has-[:checked]:border-accent has-[:checked]:bg-sand flex cursor-pointer items-center gap-3 rounded-lg border p-3 transition">
            <input
              type="radio"
              name="location"
              value={l.value}
              class="accent-[#e6863a]"
              required
            />
            <span class="text-navy/80 text-sm">{l.label}</span>
          </label>
        ))
      }
    </div>
  </div>

  <!-- Step 2: Service -->
  <div data-step="2" class="hidden">
    <h2 class="font-display text-navy text-2xl font-bold uppercase">
      What do you need?
    </h2>
    <select
      data-service
      class="border-navy/15 text-navy mt-4 w-full rounded-lg border bg-white p-3"
      required
    >
      <option value="">Choose a service *</option>
    </select>
  </div>

  <!-- Step 3: Vehicle -->
  <div data-step="3" class="hidden">
    <h2 class="font-display text-navy text-2xl font-bold uppercase">
      Your vehicle
    </h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <input
        data-make
        placeholder="Make (e.g. Chevy)"
        class="border-navy/15 rounded-lg border p-3"
      />
      <input
        data-model
        placeholder="Model (e.g. Silverado)"
        class="border-navy/15 rounded-lg border p-3"
      />
      <input
        data-year
        placeholder="Year"
        type="number"
        min="1970"
        class="border-navy/15 rounded-lg border p-3"
      />
      <select data-type class="border-navy/15 rounded-lg border p-3" required>
        <option value="">Vehicle type *</option>
        <option>Car</option><option>SUV</option><option>Truck</option><option
          >Van</option
        ><option>RV</option><option>Other</option>
      </select>
      <input
        data-color
        placeholder="Color (optional)"
        class="border-navy/15 rounded-lg border p-3 sm:col-span-2"
      />
    </div>
  </div>

  <!-- Step 4: Date & time -->
  <div data-step="4" class="hidden">
    <h2 class="font-display text-navy text-2xl font-bold uppercase">
      Pick a day
    </h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <select data-date class="border-navy/15 rounded-lg border p-3" required>
        <option value="">Choose a date *</option>
      </select>
      <select data-time class="border-navy/15 rounded-lg border p-3" required>
        <option value="">Time *</option>
        {timeSlots.map((t) => <option>{t}</option>)}
      </select>
    </div>
  </div>

  <!-- Step 5: Contact + review -->
  <div data-step="5" class="hidden">
    <h2 class="font-display text-navy text-2xl font-bold uppercase">
      Your details
    </h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <input
        data-first
        placeholder="First name *"
        autocomplete="given-name"
        required
        class="border-navy/15 rounded-lg border p-3"
      />
      <input
        data-last
        placeholder="Last name"
        autocomplete="family-name"
        class="border-navy/15 rounded-lg border p-3"
      />
      <input
        data-phone
        placeholder="Phone (US) *"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        required
        class="border-navy/15 rounded-lg border p-3"
      />
      <input
        data-email
        placeholder="Email (optional)"
        type="email"
        autocomplete="email"
        class="border-navy/15 rounded-lg border p-3"
      />
      <div data-address-wrap class="sm:col-span-2">
        <input
          data-address
          placeholder="Service address *"
          autocomplete="street-address"
          class="border-navy/15 w-full rounded-lg border p-3"
        />
      </div>
      <textarea
        data-notes
        placeholder="Anything we should know? (condition, pet hair, etc.)"
        class="border-navy/15 rounded-lg border p-3 sm:col-span-2"
        rows="3"></textarea>
    </div>
    <label class="text-navy/70 mt-3 flex items-start gap-2 text-sm">
      <input type="checkbox" data-deposit class="mt-0.5 accent-[#e6863a]" />
      <span>I understand a deposit may be required to hold my appointment.</span
      >
    </label>
    <div data-review class="bg-sand text-navy/80 mt-4 rounded-lg p-4 text-sm">
    </div>
  </div>

  <!-- Nav -->
  <div class="mt-6 flex items-center justify-between">
    <button
      data-prev
      class="border-navy/15 text-navy/70 rounded-full border px-5 py-2.5 font-semibold disabled:opacity-0"
      >Back</button
    >
    <button
      data-next
      class="bg-accent hover:bg-navy rounded-full px-6 py-2.5 font-semibold text-white transition"
      >Next</button
    >
  </div>
  <p data-status class="mt-4 hidden text-sm font-semibold" role="status"></p>
</div>

<script>
  const apiBase = "https://api.onwheelsdetailing.com";
  const fallbackServices = [
    {
      id: "interior-refresh",
      name: "Interior Refresh",
      category: "Interior Detailing",
      price: "from $150",
    },
    {
      id: "premium-interior",
      name: "Premium Interior Restoration",
      category: "Interior Detailing",
      price: "from $250",
    },
    {
      id: "steam-hot-water",
      name: "Steam & Hot Water Extraction",
      category: "Interior Detailing",
      price: "$180 flat",
    },
    {
      id: "polish-protect",
      name: "Polish & Protect",
      category: "Paint Correction & Ceramic",
      price: "from $200",
    },
    {
      id: "two-step",
      name: "Two-Step Paint Correction",
      category: "Paint Correction & Ceramic",
      price: "quote",
    },
    {
      id: "ceramic",
      name: "Ceramic Coating (Auto)",
      category: "Paint Correction & Ceramic",
      price: "quote",
    },
    {
      id: "signature",
      name: "Signature Detail Package",
      category: "Paint Correction & Ceramic",
      price: "from $350",
    },
    {
      id: "tint-ceramic",
      name: "Window Tinting, Ceramic",
      category: "Window Tinting",
      price: "quote",
    },
    {
      id: "tint-nano",
      name: "Window Tinting, Nano-Ceramic",
      category: "Window Tinting",
      price: "quote",
    },
    {
      id: "tint-carbon",
      name: "Window Tinting, Carbon",
      category: "Window Tinting",
      price: "quote",
    },
    {
      id: "undercoat-fluid",
      name: "Undercoating, Fluid Film",
      category: "Undercoating",
      price: "$175–$300",
    },
    {
      id: "undercoat-woolwax",
      name: "Undercoating, Woolwax",
      category: "Undercoating",
      price: "$175–$300",
    },
    {
      id: "rv-wash-wax",
      name: "RV Wash & Wax",
      category: "RV Detailing",
      price: "$20/ft",
    },
    {
      id: "rv-polish-protect",
      name: "RV Polish & Protect",
      category: "RV Detailing",
      price: "$30/ft",
    },
    {
      id: "rv-oxidation",
      name: "RV Oxidation Removal",
      category: "RV Detailing",
      price: "$40/ft",
    },
    {
      id: "rv-ceramic",
      name: "RV Ceramic Coating",
      category: "RV Detailing",
      price: "$70/ft",
    },
  ];

  const locationCategories: Record<string, string[]> = {
    "Michigan - Metro Detroit": [
      "Interior Detailing",
      "Paint Correction & Ceramic",
      "RV Detailing",
    ],
    "Michigan - St. Clair": [
      "Interior Detailing",
      "Paint Correction & Ceramic",
      "RV Detailing",
    ],
    "Texas - Harris County": [
      "Interior Detailing",
      "Paint Correction & Ceramic",
      "RV Detailing",
    ],
    "Michigan - Marysville (Shop)": [
      "Interior Detailing",
      "Paint Correction & Ceramic",
      "Window Tinting",
      "RV Detailing",
    ],
    "Michigan - New Haven (Shop)": [
      "Interior Detailing",
      "Paint Correction & Ceramic",
      "Window Tinting",
      "Undercoating",
    ],
  };

  const el = document.querySelector("[data-wizard]")!;
  const steps = [...el.querySelectorAll<HTMLElement>("[data-step]")];
  const nextBtn = el.querySelector<HTMLButtonElement>("[data-next]")!;
  const prevBtn = el.querySelector<HTMLButtonElement>("[data-prev]")!;
  const statusEl = el.querySelector<HTMLElement>("[data-status]")!;
  const serviceSelect = el.querySelector<HTMLSelectElement>("[data-service]")!;
  const reviewEl = el.querySelector<HTMLElement>("[data-review]")!;

  let step = 0;
  let services = fallbackServices;

  const show = () => {
    steps.forEach((s, i) => s.classList.toggle("hidden", i !== step));
    prevBtn.classList.toggle("invisible", step === 0);
    nextBtn.textContent = step === steps.length - 1 ? "Submit" : "Next";
    el.querySelectorAll("[data-step-indicator]").forEach((ind, i) => {
      ind.classList.toggle("opacity-40", i > step);
    });
  };

  const val = (sel: string) =>
    el.querySelector<HTMLInputElement>(sel)?.value ?? "";
  const radio = (name: string) =>
    el.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)
      ?.value ?? "";
  const isMobile = () => !radio("location").includes("(Shop)");

  const summary = () =>
    [
      radio("location"),
      serviceSelect.selectedOptions[0]?.textContent,
      val("[data-make]"),
      val("[data-model]"),
      val("[data-year]"),
      el.querySelector<HTMLSelectElement>("[data-date]")?.selectedOptions[0]
        ?.textContent,
      val("[data-time]"),
    ]
      .filter(Boolean)
      .join(" · ") || "…";

  // Load services (live API → fallback)
  fetch(`${apiBase}/api/services`)
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((data) => {
      const live: typeof fallbackServices = [];
      for (const [cat, items] of Object.entries(data.services ?? {})) {
        for (const s of items as any[]) {
          live.push({
            id: s.id,
            name: s.name,
            category: cat,
            price:
              s.pricing_model === "Flat Rate"
                ? s.starting_price
                  ? `$${s.starting_price}`
                  : ""
                : s.pricing_model === "Per Foot"
                  ? s.starting_price
                    ? `$${s.starting_price}/ft`
                    : "per foot"
                  : s.pricing_model.toLowerCase(),
          });
        }
      }
      if (live.length) services = live;
    })
    .catch(() => {
      /* keep fallback */
    })
    .finally(renderServices);

  function renderServices() {
    serviceSelect.innerHTML = '<option value="">Choose a service *</option>';
    const allowed = locationCategories[radio("location")] ?? [];
    const visible = allowed.length
      ? services.filter((s) => allowed.includes(s.category))
      : services;
    const cats = [...new Set(visible.map((s) => s.category))];
    for (const cat of cats) {
      const og = document.createElement("optgroup");
      og.label = cat;
      for (const s of visible.filter((x) => x.category === cat)) {
        const o = document.createElement("option");
        o.value = s.id;
        o.textContent = `${s.name} ${s.price ? `(${s.price})` : ""}`;
        og.appendChild(o);
      }
      serviceSelect.appendChild(og);
    }
  }

  const addressWrap = el.querySelector<HTMLElement>("[data-address-wrap]")!;
  const syncAddress = () => addressWrap.classList.toggle("hidden", !isMobile());

  el.querySelectorAll<HTMLInputElement>('input[name="location"]').forEach(
    (r) => {
      r.addEventListener("change", () => {
        serviceSelect.value = "";
        renderServices();
        syncAddress();
      });
    },
  );

  // US phone auto-format: (XXX) XXX-XXXX
  el.querySelector<HTMLInputElement>("[data-phone]")!.addEventListener(
    "input",
    (e) => {
      const t = e.target as HTMLInputElement;
      const d = t.value.replace(/\D/g, "").slice(0, 10);
      if (!d) {
        t.value = "";
        return;
      }
      t.value =
        d.length > 6
          ? `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`
          : d.length > 3
            ? `(${d.slice(0, 3)}) ${d.slice(3)}`
            : `(${d}`;
    },
  );

  // Populate the date picker with the next Thu/Sat/Sun only
  const dateSelect = el.querySelector<HTMLSelectElement>("[data-date]")!;
  const pad = (n: number) => String(n).padStart(2, "0");
  const iso = (d: Date) =>
    `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  {
    const cursor = new Date();
    cursor.setHours(0, 0, 0, 0);
    let added = 0;
    while (added < 12) {
      if ([4, 6, 0].includes(cursor.getDay())) {
        const o = document.createElement("option");
        o.value = iso(cursor);
        o.textContent = cursor.toLocaleDateString("en-US", {
          weekday: "short",
          month: "short",
          day: "numeric",
        });
        dateSelect.appendChild(o);
        added++;
      }
      cursor.setDate(cursor.getDate() + 1);
    }
  }

  // Year bounds: no negatives, nothing before 1970, nothing absurdly future
  el.querySelector<HTMLInputElement>("[data-year]")!.max = String(
    new Date().getFullYear() + 1,
  );

  syncAddress();

  // Google Places address autocomplete (optional; needs PUBLIC_GOOGLE_MAPS_API_KEY)
  const gmapsKey = el.getAttribute("data-gmaps-key");
  if (
    gmapsKey &&
    !document.querySelector('script[src*="maps.googleapis.com"]')
  ) {
    const s = document.createElement("script");
    s.src = `https://maps.googleapis.com/maps/api/js?key=${gmapsKey}&libraries=places`;
    s.async = true;
    s.onload = () => {
      const addr = el.querySelector<HTMLInputElement>("[data-address]");
      const g = (window as any).google;
      if (!addr || !g?.maps?.places) return;
      const ac = new g.maps.places.Autocomplete(addr, {
        componentRestrictions: { country: "us" },
        types: ["address"],
      });
      ac.addListener("place_changed", () => {
        const place = ac.getPlace();
        if (place.formatted_address) addr.value = place.formatted_address;
      });
    };
    document.head.appendChild(s);
  }

  const validStep = (): string => {
    if (step === 0) return radio("location") ? "" : "Please choose a location.";
    if (step === 1)
      return serviceSelect.value ? "" : "Please choose a service.";
    if (step === 2) {
      if (!val("[data-type]")) return "Please select your vehicle type.";
      const y = Number(val("[data-year]"));
      if (val("[data-year]") && (y < 1970 || y > new Date().getFullYear() + 1))
        return "Please enter a valid year (1970 or newer).";
      return "";
    }
    if (step === 3) {
      if (!val("[data-date]"))
        return "Please pick a Thursday, Saturday, or Sunday.";
      if (!val("[data-time]"))
        return "Please choose a time between 9am and 5pm.";
      return "";
    }
    if (step === 4) {
      if (!val("[data-first]").trim()) return "Please enter your first name.";
      if (val("[data-phone]").replace(/\D/g, "").length !== 10)
        return "Please enter a valid US phone number.";
      if (isMobile() && !val("[data-address]").trim())
        return "Please enter your service address for mobile details.";
      return "";
    }
    return "";
  };

  nextBtn.addEventListener("click", () => {
    const err = validStep();
    if (err) {
      statusEl.textContent = err;
      statusEl.className = "mt-4 block text-sm font-semibold text-crimson";
      return;
    }
    if (step < steps.length - 1) {
      step++;
      if (step === 4) reviewEl.textContent = summary();
      show();
      return;
    }
    submit();
  });

  prevBtn.addEventListener("click", () => {
    if (step > 0) {
      step--;
      show();
    }
  });

  async function submit() {
    nextBtn.disabled = true;
    statusEl.className = "mt-4 block text-sm font-semibold text-navy/70";
    statusEl.textContent = "Submitting…";
    const payload = {
      name: [val("[data-first]"), val("[data-last]")].filter(Boolean).join(" "),
      phone: val("[data-phone]"),
      email: val("[data-email]"),
      location: radio("location"),
      job_address: val("[data-address]"),
      address: val("[data-address]"),
      vehicle_type: val("[data-type]"),
      vehicle_make: val("[data-make]"),
      vehicle_model: val("[data-model]"),
      vehicle_year: val("[data-year]"),
      vehicle_color: val("[data-color]"),
      service_id: serviceSelect.value,
      preferred_date: val("[data-date]"),
      preferred_time: val("[data-time]"),
      special_requests: val("[data-notes]"),
      deposit_agreed:
        el.querySelector<HTMLInputElement>("[data-deposit]")!.checked,
    };
    try {
      const res = await fetch(`${apiBase}/api/book`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        statusEl.className = "mt-4 block text-sm font-semibold text-navy";
        statusEl.textContent =
          data.message || "Thanks! TaSain will text you shortly to confirm.";
      } else {
        throw new Error(data.error || "Booking could not be completed.");
      }
    } catch (e) {
      statusEl.className = "mt-4 block text-sm font-semibold text-crimson";
      statusEl.textContent = `Online booking isn't reachable right now, call or text (586) 873-0656 and we'll get you scheduled.`;
    } finally {
      nextBtn.disabled = false;
    }
  }

  show();
</script>
