---
// Booking wizard — multi-step, posts to the existing CRM API.
// Fails open: if the API is unreachable (e.g. local dev), it falls back to a
// bundled service list and a "call to book" confirmation instead of erroring.
const apiBase = 'https://api.onwheelsdetailing.com';

const fallbackServices = [
  { id: 'interior-refresh', name: 'Interior Refresh', category: 'Interior Detailing', price: 'from $150' },
  { id: 'premium-interior', name: 'Premium Interior Restoration', category: 'Interior Detailing', price: 'from $250' },
  { id: 'steam-hot-water', name: 'Steam & Hot Water Extraction', category: 'Interior Detailing', price: '$180 flat' },
  { id: 'polish-protect', name: 'Polish & Protect', category: 'Paint Correction & Ceramic', price: 'from $200' },
  { id: 'two-step', name: 'Two-Step Paint Correction', category: 'Paint Correction & Ceramic', price: 'quote' },
  { id: 'ceramic', name: 'Ceramic Coating (Auto)', category: 'Paint Correction & Ceramic', price: 'quote' },
  { id: 'signature', name: 'Signature Detail Package', category: 'Paint Correction & Ceramic', price: 'from $350' },
  { id: 'tint-ceramic', name: 'Window Tinting — Ceramic', category: 'Window Tinting', price: 'quote' },
  { id: 'tint-nano', name: 'Window Tinting — Nano-Ceramic', category: 'Window Tinting', price: 'quote' },
  { id: 'tint-carbon', name: 'Window Tinting — Carbon', category: 'Window Tinting', price: 'quote' },
  { id: 'undercoat-fluid', name: 'Undercoating — Fluid Film', category: 'Undercoating', price: '$175–$300' },
  { id: 'undercoat-woolwax', name: 'Undercoating — Woolwax', category: 'Undercoating', price: '$175–$300' },
];

const locations = [
  { value: 'Michigan - Metro Detroit', label: 'Mobile — Metro Detroit' },
  { value: 'Michigan - St. Clair', label: 'Mobile — St. Clair / Port Huron' },
  { value: 'Michigan - Marysville (Shop)', label: 'Marysville garage' },
  { value: 'Michigan - New Haven (Shop)', label: 'New Haven garage (undercoating)' },
  { value: 'Texas - Harris County', label: 'Mobile — Houston, TX' },
];
---

<div data-wizard class="rounded-2xl border border-navy/10 bg-cream p-6 shadow-sm md:p-8">
  <!-- Progress -->
  <ol class="mb-6 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-navy/50" data-progress>
    {['Location', 'Service', 'Vehicle', 'Date', 'Review'].map((s, i) => (
      <li class="flex items-center gap-2" data-step-indicator={i + 1}>
        <span class="grid h-6 w-6 place-items-center rounded-full bg-sand text-navy">{i + 1}</span>
        <span class="hidden sm:inline">{s}</span>
        {i < 4 && <span class="text-navy/30">→</span>}
      </li>
    ))}
  </ol>

  <!-- Step 1: Location -->
  <div data-step="1">
    <h2 class="font-display text-2xl font-bold uppercase text-navy">Where are you?</h2>
    <div class="mt-4 grid gap-2 sm:grid-cols-2">
      {locations.map((l) => (
        <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-navy/15 p-3 transition has-[:checked]:border-accent has-[:checked]:bg-sand">
          <input type="radio" name="location" value={l.value} class="accent-[#e6863a]" required />
          <span class="text-sm text-navy/80">{l.label}</span>
        </label>
      ))}
    </div>
  </div>

  <!-- Step 2: Service -->
  <div data-step="2" class="hidden">
    <h2 class="font-display text-2xl font-bold uppercase text-navy">What do you need?</h2>
    <select data-service class="mt-4 w-full rounded-lg border border-navy/15 bg-white p-3 text-navy" required>
      <option value="">Choose a service…</option>
    </select>
  </div>

  <!-- Step 3: Vehicle -->
  <div data-step="3" class="hidden">
    <h2 class="font-display text-2xl font-bold uppercase text-navy">Your vehicle</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <input data-make placeholder="Make (e.g. Chevy)" class="rounded-lg border border-navy/15 p-3" />
      <input data-model placeholder="Model (e.g. Silverado)" class="rounded-lg border border-navy/15 p-3" />
      <input data-year placeholder="Year" type="number" class="rounded-lg border border-navy/15 p-3" />
      <select data-type class="rounded-lg border border-navy/15 p-3">
        <option value="">Vehicle type</option>
        <option>Car</option><option>SUV</option><option>Truck</option><option>Van</option><option>RV</option><option>Other</option>
      </select>
      <input data-color placeholder="Color (optional)" class="rounded-lg border border-navy/15 p-3 sm:col-span-2" />
    </div>
  </div>

  <!-- Step 4: Date & time -->
  <div data-step="4" class="hidden">
    <h2 class="font-display text-2xl font-bold uppercase text-navy">Pick a day</h2>
    <p class="mt-1 text-xs text-navy/50">We detail Thursday, Saturday &amp; Sunday, 9am–5pm.</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <input data-date type="date" class="rounded-lg border border-navy/15 p-3" />
      <select data-time class="rounded-lg border border-navy/15 p-3">
        <option value="">Time</option>
        <option>9:00 AM</option><option>11:00 AM</option><option>1:00 PM</option><option>3:00 PM</option>
      </select>
    </div>
  </div>

  <!-- Step 5: Contact + review -->
  <div data-step="5" class="hidden">
    <h2 class="font-display text-2xl font-bold uppercase text-navy">Your details</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <input data-name placeholder="Full name" class="rounded-lg border border-navy/15 p-3" />
      <input data-phone placeholder="Phone" type="tel" class="rounded-lg border border-navy/15 p-3" />
      <input data-email placeholder="Email (optional)" type="email" class="rounded-lg border border-navy/15 p-3 sm:col-span-2" />
      <textarea data-notes placeholder="Anything we should know? (condition, pet hair, etc.)" class="rounded-lg border border-navy/15 p-3 sm:col-span-2" rows="3"></textarea>
    </div>
    <label class="mt-3 flex items-start gap-2 text-sm text-navy/70">
      <input type="checkbox" data-deposit class="mt-0.5 accent-[#e6863a]" />
      <span>I understand a deposit may be required to hold my appointment.</span>
    </label>
    <div data-review class="mt-4 rounded-lg bg-sand p-4 text-sm text-navy/80"></div>
  </div>

  <!-- Nav -->
  <div class="mt-6 flex items-center justify-between">
    <button data-prev class="rounded-full border border-navy/15 px-5 py-2.5 font-semibold text-navy/70 disabled:opacity-0">Back</button>
    <button data-next class="rounded-full bg-accent px-6 py-2.5 font-semibold text-white transition hover:bg-navy">Next</button>
  </div>
  <p data-status class="mt-4 hidden text-sm font-semibold" role="status"></p>
</div>

<script define:vars={{ apiBase, fallbackServices }}>
  const el = document.querySelector('[data-wizard]')!;
  const steps = [...el.querySelectorAll<HTMLElement>('[data-step]')];
  const nextBtn = el.querySelector<HTMLButtonElement>('[data-next]')!;
  const prevBtn = el.querySelector<HTMLButtonElement>('[data-prev]')!;
  const statusEl = el.querySelector<HTMLElement>('[data-status]')!;
  const serviceSelect = el.querySelector<HTMLSelectElement>('[data-service]')!;
  const reviewEl = el.querySelector<HTMLElement>('[data-review]')!;

  let step = 0;
  let services = fallbackServices;

  const show = () => {
    steps.forEach((s, i) => s.classList.toggle('hidden', i !== step));
    prevBtn.classList.toggle('invisible', step === 0);
    nextBtn.textContent = step === steps.length - 1 ? 'Submit' : 'Next';
    el.querySelectorAll('[data-step-indicator]').forEach((ind, i) => {
      ind.classList.toggle('opacity-40', i > step);
    });
  };

  const val = (sel: string) => el.querySelector<HTMLInputElement>(sel)?.value ?? '';
  const radio = (name: string) => el.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';

  const summary = () =>
    [radio('location'), serviceSelect.selectedOptions[0]?.textContent, val('[data-make]'), val('[data-model]'), val('[data-year]'), val('[data-date]'), val('[data-time]')]
      .filter(Boolean).join(' · ') || '…';

  // Load services (live API → fallback)
  fetch(`${apiBase}/api/services`)
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((data) => {
      const live: typeof fallbackServices = [];
      for (const [cat, items] of Object.entries(data.services ?? {})) {
        for (const s of items as any[]) {
          live.push({ id: s.id, name: s.name, category: cat, price: s.pricing_model === 'Flat Rate' ? (s.starting_price ? `$${s.starting_price}` : '') : s.pricing_model.toLowerCase() });
        }
      }
      if (live.length) services = live;
    })
    .catch(() => { /* keep fallback */ })
    .finally(renderServices);

  function renderServices() {
    serviceSelect.innerHTML = '<option value="">Choose a service…</option>';
    const cats = [...new Set(services.map((s) => s.category))];
    for (const cat of cats) {
      const og = document.createElement('optgroup');
      og.label = cat;
      for (const s of services.filter((x) => x.category === cat)) {
        const o = document.createElement('option');
        o.value = s.id; o.textContent = `${s.name} ${s.price ? `(${s.price})` : ''}`;
        og.appendChild(o);
      }
      serviceSelect.appendChild(og);
    }
  }

  const validStep = (): boolean => {
    if (step === 0) return !!radio('location');
    if (step === 1) return !!serviceSelect.value;
    if (step === 3) {
      const d = val('[data-date]');
      if (!d) return false;
      const day = new Date(d + 'T12:00:00').getDay(); // Thu=4, Sat=6, Sun=0
      return [4, 6, 0].includes(day);
    }
    if (step === 4) return !!val('[data-name]') && val('[data-phone]').replace(/\D/g, '').length >= 10;
    return true;
  };

  nextBtn.addEventListener('click', () => {
    if (!validStep()) {
      statusEl.textContent = step === 3 ? 'Please pick a Thursday, Saturday, or Sunday.' : 'Please fill in the highlighted step.';
      statusEl.className = 'mt-4 block text-sm font-semibold text-crimson';
      return;
    }
    if (step < steps.length - 1) {
      step++;
      if (step === 4) reviewEl.textContent = summary();
      show();
      return;
    }
    submit();
  });

  prevBtn.addEventListener('click', () => { if (step > 0) { step--; show(); } });

  async function submit() {
    nextBtn.disabled = true;
    statusEl.className = 'mt-4 block text-sm font-semibold text-navy/70';
    statusEl.textContent = 'Submitting…';
    const payload = {
      name: val('[data-name]'),
      phone: val('[data-phone]'),
      email: val('[data-email]'),
      location: radio('location'),
      vehicle_type: val('[data-type]'),
      vehicle_make: val('[data-make]'),
      vehicle_model: val('[data-model]'),
      vehicle_year: val('[data-year]'),
      vehicle_color: val('[data-color]'),
      service_id: serviceSelect.value,
      preferred_date: val('[data-date]'),
      preferred_time: val('[data-time]'),
      special_requests: val('[data-notes]'),
      deposit_agreed: el.querySelector<HTMLInputElement>('[data-deposit]')!.checked,
    };
    try {
      const res = await fetch(`${apiBase}/api/book`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        statusEl.className = 'mt-4 block text-sm font-semibold text-navy';
        statusEl.textContent = data.message || "Thanks! TaSain will text you shortly to confirm.";
      } else {
        throw new Error(data.error || 'Booking could not be completed.');
      }
    } catch (e) {
      statusEl.className = 'mt-4 block text-sm font-semibold text-crimson';
      statusEl.textContent = `Online booking isn't reachable right now — call or text (586) 873-0656 and we'll get you scheduled.`;
    } finally {
      nextBtn.disabled = false;
    }
  }

  show();
</script>
