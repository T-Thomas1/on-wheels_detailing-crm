---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
---

<BaseLayout
  title="Services — Auto Detailing, Ceramic Coating, Tinting & Undercoating"
  description="Full-service detailing: interior and paint correction, CarPro ceramic coating, GEOShield window tinting, and Fluid Film/Woolwax undercoating."
>
  <section class="bg-navy py-20 text-center">
    <div class="container-x">
      <h1 class="text-5xl font-bold text-cream md:text-6xl">Services</h1>
      <p class="mx-auto mt-4 max-w-xl text-cream/75">
        Detailing, protection, and restoration — every service backed by the On-Wheels standard.
      </p>
    </div>
  </section>

  <section id="detailing" class="container-x py-16">
    <h2 class="text-3xl font-bold text-navy">Detailing</h2>
    <p class="mt-2 max-w-2xl text-navy/70">Complete interior and exterior care. (Pricing tiered by vehicle size — final on booking.)</p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div class="rounded-xl border border-navy/10 bg-sand p-6">
        <h3 class="text-xl font-bold text-navy">Interior Refresh</h3>
        <p class="mt-2 text-sm text-navy/70">Vacuum, wipe-down, glass, light stain treatment.</p>
        <p class="mt-3 font-display font-bold text-accent">From $150</p>
      </div>
      <div class="rounded-xl border border-navy/10 bg-sand p-6">
        <h3 class="text-xl font-bold text-navy">Premium Interior</h3>
        <p class="mt-2 text-sm text-navy/70">Deep clean with hot water extraction & steam.</p>
        <p class="mt-3 font-display font-bold text-accent">From $250</p>
      </div>
      <div class="rounded-xl border border-navy/10 bg-sand p-6">
        <h3 class="text-xl font-bold text-navy">Steam & Hot Water</h3>
        <p class="mt-2 text-sm text-navy/70">Sanitizing steam + hot water extraction.</p>
        <p class="mt-3 font-display font-bold text-accent">$180 flat</p>
      </div>
    </div>
    <div class="mt-6"><Placeholder label="Detailing before/after" note="Upload: images/detail-interior.webp · 1200×800" class="aspect-[3/2]" /></div>
  </section>

  <section id="paint-ceramic" class="container-x border-t border-navy/10 py-16">
    <h2 class="text-3xl font-bold text-navy">Paint Correction &amp; Ceramic</h2>
    <p class="mt-2 max-w-2xl text-navy/70">Restore depth, clarity, and protection. Coated with CarPro CQuartz 3.0.</p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="rounded-xl border border-navy/10 bg-sand p-6">
        <h3 class="text-xl font-bold text-navy">Polish &amp; Protect</h3>
        <p class="mt-2 text-sm text-navy/70">Single-stage polish + premium sealant.</p>
        <p class="mt-3 font-display font-bold text-accent">From $200</p>
      </div>
      <div class="rounded-xl border border-navy/10 bg-sand p-6">
        <h3 class="text-xl font-bold text-navy">Two-Step Correction</h3>
        <p class="mt-2 text-sm text-navy/70">Compound + polish to remove swirls and oxidation.</p>
        <p class="mt-3 font-display font-bold text-accent">Quote only</p>
      </div>
      <div class="rounded-xl border border-navy/10 bg-sand p-6">
        <h3 class="text-xl font-bold text-navy">Ceramic Coating</h3>
        <p class="mt-2 text-sm text-navy/70">CarPro CQuartz 3.0 — 2+ years of hydrophobic protection.</p>
        <p class="mt-3 font-display font-bold text-accent">Quote only</p>
      </div>
      <div class="rounded-xl border border-navy/10 bg-sand p-6">
        <h3 class="text-xl font-bold text-navy">Signature Detail</h3>
        <p class="mt-2 text-sm text-navy/70">Interior refresh + exterior polish & protect. The full treatment.</p>
        <p class="mt-3 font-display font-bold text-accent">From $350</p>
      </div>
    </div>
    <div class="mt-6"><Placeholder label="Ceramic coating — water beading" note="Upload: images/ceramic-beading.webp · 1200×800" class="aspect-[3/2]" /></div>
  </section>

  <section class="container-x border-t border-navy/10 py-16">
    <div class="grid gap-6 md:grid-cols-2">
      <a href="/tinting" class="rounded-xl border border-navy/10 bg-sand p-8 transition hover:-translate-y-1 hover:shadow-md">
        <h2 class="text-3xl font-bold text-navy">Window Tinting</h2>
        <p class="mt-2 text-navy/70">GEOShield ceramic, nano-ceramic & carbon films. See your shade →</p>
      </a>
      <a href="/undercoating" class="rounded-xl border border-navy/10 bg-sand p-8 transition hover:-translate-y-1 hover:shadow-md">
        <h2 class="text-3xl font-bold text-navy">Undercoating</h2>
        <p class="mt-2 text-navy/70">Fluid Film & Woolwax rust protection for Michigan winters →</p>
      </a>
    </div>
  </section>
</BaseLayout>
