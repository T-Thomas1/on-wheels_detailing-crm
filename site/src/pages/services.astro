---
import BaseLayout from "../layouts/BaseLayout.astro";
import Placeholder from "../components/Placeholder.astro";
---

<BaseLayout
  title="Services | Auto & RV Detailing, Ceramic, Tinting & Undercoating"
  description="Full-service auto and RV detailing: interior and paint correction, per-foot RV care, CarPro ceramic coating, GEOShield window tinting, and Fluid Film/Woolwax undercoating."
>
  <section class="bg-navy py-20 text-center">
    <div class="container-x">
      <h1 class="text-cream text-5xl font-bold md:text-6xl">Services</h1>
      <p class="text-cream/75 mx-auto mt-4 max-w-xl">
        Detailing, protection, and restoration, every service backed by the
        On-Wheels standard.
      </p>
    </div>
  </section>

  <section id="detailing" class="container-x py-16">
    <h2 class="text-navy text-3xl font-bold">Detailing</h2>
    <p class="text-navy/70 mt-2 max-w-2xl">
      Complete interior and exterior care. (Pricing tiered by vehicle size ,
      final on booking.)
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">Interior Refresh</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Vacuum, wipe-down, glass, light stain treatment.
        </p>
        <p class="font-display text-accent mt-3 font-bold">From $150</p>
      </div>
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">Premium Interior</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Deep clean with hot water extraction & steam.
        </p>
        <p class="font-display text-accent mt-3 font-bold">From $250</p>
      </div>
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">Steam & Hot Water</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Sanitizing steam + hot water extraction.
        </p>
        <p class="font-display text-accent mt-3 font-bold">$180 flat</p>
      </div>
    </div>
    <div class="mt-6">
      <Placeholder
        label="Detailing before/after"
        note="Upload: images/detail-interior.webp · 1200×800"
        class="aspect-[3/2]"
      />
    </div>
  </section>

  <section id="paint-ceramic" class="container-x border-navy/10 border-t py-16">
    <h2 class="text-navy text-3xl font-bold">Paint Correction &amp; Ceramic</h2>
    <p class="text-navy/70 mt-2 max-w-2xl">
      Restore depth, clarity, and protection. Coated with CarPro CQuartz 3.0.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">Polish &amp; Protect</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Single-stage polish + premium sealant.
        </p>
        <p class="font-display text-accent mt-3 font-bold">From $200</p>
      </div>
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">Two-Step Correction</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Compound + polish to remove swirls and oxidation.
        </p>
        <p class="font-display text-accent mt-3 font-bold">Quote only</p>
      </div>
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">Ceramic Coating</h3>
        <p class="text-navy/70 mt-2 text-sm">
          CarPro CQuartz 3.0, 2+ years of hydrophobic protection.
        </p>
        <p class="font-display text-accent mt-3 font-bold">Quote only</p>
      </div>
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">Signature Detail</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Interior refresh + exterior polish & protect. The full treatment.
        </p>
        <p class="font-display text-accent mt-3 font-bold">From $350</p>
      </div>
    </div>
    <div class="mt-6">
      <Placeholder
        label="Ceramic coating, water beading"
        note="Upload: images/ceramic-beading.webp · 1200×800"
        class="aspect-[3/2]"
      />
    </div>
  </section>

  <section id="rv-detailing" class="container-x border-navy/10 border-t py-16">
    <h2 class="text-navy text-3xl font-bold">RV Detailing</h2>
    <p class="text-navy/70 mt-2 max-w-2xl">
      Exterior care for RVs, campers, and trailers, priced per linear foot.
      Available mobile and at the Marysville garage.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">RV Wash &amp; Wax</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Hand wash with premium wax/sealant + UV protection.
        </p>
        <p class="font-display text-accent mt-3 font-bold">$20 / ft</p>
      </div>
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">RV Polish &amp; Protect</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Single-stage polish + sealant to revive faded gelcoat.
        </p>
        <p class="font-display text-accent mt-3 font-bold">$30 / ft</p>
      </div>
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">RV Oxidation Removal</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Compound + polish to restore chalked, oxidized gelcoat.
        </p>
        <p class="font-display text-accent mt-3 font-bold">$40 / ft</p>
      </div>
      <div class="border-navy/10 bg-sand rounded-xl border p-6">
        <h3 class="text-navy text-xl font-bold">RV Ceramic Coating</h3>
        <p class="text-navy/70 mt-2 text-sm">
          Long-term ceramic protection for RVs and campers.
        </p>
        <p class="font-display text-accent mt-3 font-bold">$70 / ft</p>
      </div>
    </div>
  </section>

  <section class="container-x border-navy/10 border-t py-16">
    <div class="grid gap-6 md:grid-cols-2">
      <a
        href="/tinting"
        class="border-navy/10 bg-sand rounded-xl border p-8 transition hover:-translate-y-1 hover:shadow-md"
      >
        <h2 class="text-navy text-3xl font-bold">Window Tinting</h2>
        <p class="text-navy/70 mt-2">
          GEOShield ceramic, nano-ceramic & carbon films. See your shade →
        </p>
      </a>
      <a
        href="/undercoating"
        class="border-navy/10 bg-sand rounded-xl border p-8 transition hover:-translate-y-1 hover:shadow-md"
      >
        <h2 class="text-navy text-3xl font-bold">Undercoating</h2>
        <p class="text-navy/70 mt-2">
          Fluid Film & Woolwax rust protection for Michigan winters →
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
