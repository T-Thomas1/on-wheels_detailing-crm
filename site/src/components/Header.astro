---
const services = [
  { label: "Detailing", href: "/services#detailing" },
  { label: "Paint & Ceramic", href: "/services#paint-ceramic" },
  { label: "Window Tinting", href: "/tinting" },
  { label: "Undercoating", href: "/undercoating" },
];

const links = [
  { label: "Home", href: "/" },
  { label: "Gallery", href: "/gallery" },
  { label: "Locations", href: "/locations" },
  { label: "About", href: "/about" },
];
---

<header
  class="border-navy/10 bg-cream/95 sticky top-0 z-50 border-b backdrop-blur"
>
  <div class="container-x flex items-center justify-between py-3">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/images/onwheelsLogoMark.webp"
        alt="On-Wheels Detailing logo mark"
        class="h-10 w-auto"
        width="40"
        height="40"
      />
      <span
        class="font-display text-xl leading-none font-bold tracking-wide uppercase"
      >
        On-<span class="text-accent">Wheels</span> Detailing
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      <a href="/" class="text-navy/80 hover:text-accent text-sm font-medium"
        >Home</a
      >

      <div class="group relative">
        <button
          class="text-navy/80 hover:text-accent flex items-center gap-1 text-sm font-medium"
        >
          Services
          <span class="text-xs" aria-hidden="true">▾</span>
        </button>
        <div
          class="border-navy/10 bg-cream absolute top-full left-0 hidden min-w-[13rem] rounded-lg border p-2 shadow-lg group-hover:block"
        >
          {
            services.map((s) => (
              <a
                href={s.href}
                class="text-navy/80 hover:bg-sand hover:text-accent block rounded-md px-3 py-2 text-sm"
              >
                {s.label}
              </a>
            ))
          }
        </div>
      </div>

      {
        links.slice(1).map((l) => (
          <a
            href={l.href}
            class="text-navy/80 hover:text-accent text-sm font-medium"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/book"
        class="bg-accent hover:bg-navy hidden rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition sm:inline-block"
      >
        Book Now
      </a>
      <button
        id="nav-toggle"
        class="border-navy/15 text-navy rounded-md border px-3 py-2 lg:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="border-navy/10 bg-cream hidden border-t px-4 py-4 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      <a
        href="/"
        class="text-navy/80 hover:bg-sand rounded-md px-3 py-2 text-sm font-medium"
        >Home</a
      >
      <p
        class="text-navy/50 px-3 pt-2 text-xs font-semibold tracking-wide uppercase"
      >
        Services
      </p>
      {
        services.map((s) => (
          <a
            href={s.href}
            class="text-navy/80 hover:bg-sand rounded-md px-3 py-2 text-sm font-medium"
          >
            {s.label}
          </a>
        ))
      }
      {
        links.slice(1).map((l) => (
          <a
            href={l.href}
            class="text-navy/80 hover:bg-sand rounded-md px-3 py-2 text-sm font-medium"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/book"
        class="bg-accent mt-2 rounded-full px-4 py-2.5 text-center text-sm font-semibold text-white"
        >Book Now</a
      >
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const hidden = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!hidden));
  });
</script>
